{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Traylist",
  "version": "0.1.0",
  "identifier": "com.traylist.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Traylist",
        "width": 360,
        "height": 480,
        "minWidth": 320,
        "minHeight": 360,
        "resizable": false,
        "decorations": false,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "focus": false,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Fast local tray list",
    "longDescription": "A lightweight, local-first todo list that lives in your system tray."
  }
}
